# API Key（Bearer 鉴权）。changeme 是占位符，请换成你自己的随机密钥。
TW2A_API_KEY=changeme

# Work 通道运行模式 (可选，默认 native 纯协议直连):
# native: 纯 Go 协议直连 api5-normal.mchost.guru (Zero-Electron 推荐)
# auto: 优先 native，失败平滑降级 bridge
# bridge: 外部兼容桥接模式
# disabled: 全局禁用 Work 专有通道
# TW2A_WORK_MODE=native

# 兼容外部 WorkBridge (仅 bridge 或 auto 模式下使用，可选):
# TW2A_WORK_BRIDGE_URL=http://127.0.0.1:7865
# TW2A_WORK_BRIDGE_TOKEN=twbridge-local-7f3a
